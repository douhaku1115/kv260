# ---- 段13 CNN(MNIST) ----
# .gitignore は行末コメントを解釈しない。コメントは必ず独立した行に書く。
# Vivado のプロジェクト一式（65MB）。create_cnn_project.tcl で再生成できる
kv260_cnn/vivado/
# xsim の作業場。run_sim.sh で再生成できる
kv260_cnn/simbuild/
# MNIST 本体（64MB）。train_mnist.py data で取得できる
kv260_cnn/train/data/
kv260_cnn/vivado_build.log
kv260_cnn/vivado_build.jou
# Vivado が作業中に吐くログ
dfx_runtime.txt
retry_open_fs.log

# ---- Zephyr (R5) ----
# psu_init_nousb.tcl は kaleidoscope/tools/make_psu_nousb.py で作る。elf は build.sh で作る
kv260_zephyr/psu_init_nousb.tcl
kv260_zephyr/*.elf
kv260_zephyr/*.txt

# ---- NES ----
# Vivado のプロジェクト一式。vivado.tcl で再生成できる
kv260_nes/project_1/
# xsim の作業場。sim/run_sim.sh で再生成できる
kv260_nes/sim/simbuild/
# テスト ROM と正解ログ。配布元から取得する (README 参照)
kv260_nes/roms/
